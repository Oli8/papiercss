{
  "name": "papiercss",
  "version": "0.1.0",
  "description": "The less formal CSS framework - with Tailwind",
  "type": "module",
  "main": "./src/index.css",
  "style": "./src/index.css",
  "exports": {
    ".": "./src/index.css",
    "./theme": "./src/theme.css",
    "./theme.css": "./src/theme.css",
    "./fonts": "./src/fonts.css",
    "./fonts.css": "./src/fonts.css",
    "./utilities": "./src/utilities/index.css",
    "./utilities.css": "./src/utilities/index.css",
    "./components": "./src/components/index.css",
    "./components.css": "./src/components/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "npm run demo:build",
    "demo:build": "tailwindcss -i ./demo/style.css -o ./demo/dist.css",
    "demo:watch": "tailwindcss -i ./demo/style.css -o ./demo/dist.css --watch",
    "demo": "npx --yes serve demo -p 5173",
    "dev": "npm run demo:watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oli8/papiercss.git"
  },
  "author": "Oli8",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Oli8/papiercss/issues"
  },
  "homepage": "https://www.getpapercss.com",
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.11",
    "tailwindcss": "^4.1.11"
  },
  "keywords": [
    "css",
    "framework",
    "tailwind",
    "paper",
    "design"
  ]
}
